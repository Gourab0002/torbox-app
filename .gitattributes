# Normalize line endings to LF in the repository and working tree.
#
# Several checks compare file contents byte-for-byte across platforms
# (e.g. `prettier --check` with endOfLine: lf, and the i18n verify step), so a
# Windows checkout with core.autocrlf=true must not rewrite them to CRLF.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets should never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
